# Copy to backend/.env for local development. Never commit backend/.env.
# On Render, set these as environment variables instead.

# Use the postgresql+psycopg:// prefix (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/budget_tracker

# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required when APP_ENV=production. Locally a random key is used if empty.
SECRET_KEY=

# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
# Required when APP_ENV=production. localhost:5173 is allowed automatically outside production.
FRONTEND_URL=https://your-frontend.vercel.app

# development | production
APP_ENV=development
APP_NAME=Budget Tracker API
BACKEND_PORT=8000
